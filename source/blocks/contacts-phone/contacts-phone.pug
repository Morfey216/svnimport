include ../svg/svg

mixin contacts-phone(mod, icon)
  div(class='contacts-phone')&attributes(attributes)
    div(class= mod ? 'contacts-phone__phones--' + mod : '').contacts-phone__phones
      a(href="tel:+905380635343" onclick="ym(65809255,'reachGoal','RB_PHONE_CLICK'); gtag('event', 'click', {'event_category': 'Phones', 'event_label': 'RB_PHONE_CLICK'}); return true;").contacts-phone__phone.contacts-phone__phone--first
        span
          +svg('tr')(width="16" height="12")
        span +90 53 806 35 343
      a(href="https://api.whatsapp.com/send?phone=375296095056" target="_blank" title="Написать в Whatsapp" rel="noopener noreferrer" onclick="ym(65809255,'reachGoal',' messengerClick'); gtag('event', 'click', {'event_category': 'Messenger', 'event_label': 'MESSENGER_CLICK'}); return true;").contacts-phone__phone.contacts-phone__phone--second
        img(src='img/icons/whatsapp.svg' width= "16" height= "16" alt= "")
        span +375 29 609 50 56
      a(href="https://telegram.me/broker_grupp" target="_blank" onclick="ym(65809255,'reachGoal',' messengerClick'); gtag('event', 'click', {'event_category': 'Messenger', 'event_label': 'MESSENGER_CLICK'}); return true;").contacts-phone__phone.contacts-phone__phone--second
        img(src='img/icons/telegram.svg' width= "16" height= "12" alt= "")
        span +375 29 797 82 41
      if (mod === 'messenger')
        p.contacts-phone__messenger (whatsapp, telegram, viber)
